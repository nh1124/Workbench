UI_DEV_HOST=127.0.0.1
UI_DEV_PORT=5174

# Point this at the Vite dev server so UI and Core share one origin, which is what
# the HttpOnly refresh cookie needs in order to survive a reload. Vite proxies
# Core's routes to VITE_WORKBENCH_CORE_PROXY_TARGET below. Production needs no
# equivalent: Core serves ui/dist, so it is already one origin.
VITE_WORKBENCH_CORE_URL=http://127.0.0.1:5174

# Where Vite forwards Core's routes during dev.
VITE_WORKBENCH_CORE_PROXY_TARGET=http://127.0.0.1:4100

# Alternative: talk to Core directly. Everything still works except that the
# browser session will not survive a page reload, because the cookie is then
# cross-origin and is not sent.
# VITE_WORKBENCH_CORE_URL=http://127.0.0.1:4100
