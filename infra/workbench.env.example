# Workbench canonical local service settings.
# Runtime .env files keep secrets and DB settings, while service ports and URLs
# are synchronized from this file by infra/scripts/workbench-env.mjs.

WORKBENCH_HOST=127.0.0.1

CORE_BIND_HOST=0.0.0.0
CORE_PORT=4100
NOTES_PORT=4101
ARTIFACTS_PORT=4102
TASKS_PORT=4103
PROJECTS_PORT=4104
IMAGES_PORT=4105
MINDMAPS_PORT=4106
WBS_PORT=4107
INSIGHTS_PORT=4108
UI_DEV_HOST=127.0.0.1
UI_DEV_PORT=5174

# Optional Core-origin enforcement for user-facing domain service mutations.
WORKBENCH_REQUIRE_CORE_MUTATION_ORIGIN=false
WORKBENCH_CORE_MUTATION_TOKEN=

# Logging (services read these from their process env; see
# docs/imple/logging-foundation-plan.md). All optional:
#   WORKBENCH_LOG_DIR             default <repo root>/logs
#   LOG_LEVEL                     debug|info|warn|error, default info
#   WORKBENCH_LOG_RETENTION_DAYS  default 14
#   WORKBENCH_LOG_CONSOLE        set 0 to disable the stderr mirror
