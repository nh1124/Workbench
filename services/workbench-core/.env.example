CORE_SERVICE_HOST=0.0.0.0
CORE_SERVICE_PORT=4100
CORE_EXTERNAL_BASE_URL=https://your-public-workbench.example.com

CORE_DB_HOST=127.0.0.1
CORE_DB_PORT=5542
CORE_DB_NAME=workbench_core_db
CORE_DB_USER=workbench_user
CORE_DB_PASSWORD=workbench_pass

JWT_SECRET=change-this-workbench-jwt-secret
JWT_ISSUER=workbench-core
JWT_EXPIRY_SECONDS=3600
OAUTH_REFRESH_TOKEN_EXPIRY_SECONDS=2592000
OAUTH_CLIENT_METADATA_HOST_ALLOWLIST=

NOTES_SERVICE_URL=http://127.0.0.1:4101
ARTIFACTS_SERVICE_URL=http://127.0.0.1:4102
TASKS_SERVICE_URL=http://127.0.0.1:4103
PROJECTS_SERVICE_URL=http://127.0.0.1:4104
IMAGES_SERVICE_URL=http://127.0.0.1:4105
MINDMAPS_SERVICE_URL=http://127.0.0.1:4106
WBS_SERVICE_URL=http://127.0.0.1:4107
INSIGHTS_SERVICE_URL=http://127.0.0.1:4108
ANALYSER_SERVICE_URL=http://127.0.0.1:4109

INTERNAL_API_KEY_NOTES=workbench-internal-notes
INTERNAL_API_KEY_ARTIFACTS=workbench-internal-artifacts
INTERNAL_API_KEY_PROJECTS=workbench-internal-projects
INTERNAL_API_KEY_IMAGES=workbench-internal-images
INTERNAL_API_KEY_MINDMAPS=workbench-internal-mindmaps
INTERNAL_API_KEY_WBS=workbench-internal-wbs
INTERNAL_API_KEY_INSIGHTS=workbench-internal-insights
INTERNAL_API_KEY_ANALYSER=workbench-internal-analyser

# Optional: sent to domain services with non-read Core-origin mutations.
WORKBENCH_CORE_MUTATION_TOKEN=
