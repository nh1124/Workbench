# Project Settings
PROJECT_NAME="LBS Microservice"
API_V1_STR="/api/lbs"
LBS_SECRET_KEY="your-super-secret-key-change-me"

# Server Configuration
BACKEND_PORT=8100
LBS_HOST_PORT=8100

# Frontend Configuration (for browser)
VITE_API_BASE_URL="http://localhost:8100/api/lbs"

# Database Configuration
# For local development outside Docker, researchers might use sqlite:
# DATABASE_URL=sqlite:///./lbs.db
# For Docker production use:
# DATABASE_URL=postgresql://lbs_user:lbs_password@db:5432/lbs_db

# LBS Defaults
DEFAULT_ALPHA=0.1
DEFAULT_BETA=1.2
DEFAULT_CAP=8.0
DEFAULT_SWITCH_COST=0.5
LBS_REFRESH_DEBOUNCE_ENABLED=true
LBS_REFRESH_DEBOUNCE_SECONDS=1

# LBS Security & Environment
LBS_ENV=dev
LBS_BIND_HOST=127.0.0.1
LBS_REQUIRE_API_KEY=false
LBS_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000
LBS_ENABLE_DEV_HEADER_AUTH=false
LBS_CORS_ALLOW_ORIGINS=*
